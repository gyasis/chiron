{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-open",
    "fs:default",
    "fs:allow-read-file",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "matchmadness://*" },
        { "url": "http://*" },
        { "url": "https://*" }
      ]
    },
    "deep-link:default",
    "chiron-llm:default"
  ]
}
