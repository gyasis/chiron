# SQLite scratch DBs at repo root (these are runtime state, not source)
deep_research.db
deep_research.db-journal
*.chiron-state.db
*.chiron-state.db-journal

# Per-user memory-bank (private notes, may include unshared context)
memory-bank/private/

# SpecStory conversation history — local only, may contain secrets
.specstory/

# Agent-state memory (PRD registry / session state — local, secret leak surface)
.memory/

# Key / cert material — never commit
*.key
*.pem

skill/_*.mjs

# session artifacts / build junk
__pycache__/
*.pyc
.playwright-mcp/
console-*.yml
console-*.png
r-filter.yml
/corpus/
.appstore-vc

# il-centro — source scripts are tracked; recordings and baked audio are not.
# Lesson audio travels as a .chiron bundle (skill/CHIRON-FORMAT.md), never in git.
skill/il-centro/audio/
skill/il-centro/_archive/
skill/il-centro/*.mp3
skill/il-centro/*.wav
skill/il-centro/**/*.mp3
skill/il-centro/**/*.wav
skill/il-centro/*.bak
# Barbara's own class handout + transcript — her material, not ours to publish.
skill/il-centro/Lezione-Barbara-*.pdf
skill/il-centro/lezione-*.md
skill/il-centro/barbara-*.tsv
